# Copy to config/config.env and fill in real values. Never commit the real file.

PORT=4000
NODE_ENV=development

# MongoDB connection string (Atlas or self-hosted replica set)
MONGOURI=mongodb+srv://user:password@cluster.example.mongodb.net/dbname?appName=Cluster0

# Long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=5d
COOKIE_EXPIRE=5

# Frontend base URL — used to build password-reset links
FRONTEND_URL=http://localhost:3000

# Comma-separated browser origins allowed to call the API. Leave unset in dev.
# CORS_ORIGINS=https://your-frontend.example.com,http://localhost:3000

# Set to "true" only when connected to a replica set (Atlas). Defaults to true in production.
# SESSIONS_ENABLED=true

# SMTP (password-reset email). Gmail: SMPT_SERVICE=gmail, SMPT_MAIL + app password.
SMPT_SERVICE=gmail
SMPT_HOST=smtp.gmail.com
SMPT_PORT=465
SMPT_MAIL=
SMPT_PASSWORD=
